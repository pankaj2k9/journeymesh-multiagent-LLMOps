# =============================================================================
# Travel Crew AI - local development environment
#
#   cp .env.dev.example .env.dev
#   make dev-local
#
# This file configures docker-compose.dev.yml and nothing else. Production
# values live in /opt/journeymesh/.env ON THE VPS and never in this repository.
#
# Everything here is optional. With no credentials at all the stack runs end to
# end: the agents produce structured results and every unconfirmed price is
# labelled an ESTIMATE. Fill in only what you have.
#
# .env.dev is git-ignored. Only this template is committed, and it must never
# gain a real value - the repository is public.
# =============================================================================

APP_ENV=development
DEBUG=true

# ---- Database --------------------------------------------------------------
# Development-only credentials, deliberately trivial and deliberately public.
# The database is published on 127.0.0.1 only and holds nothing real.
POSTGRES_USER=journeymesh
POSTGRES_PASSWORD=journeymesh
POSTGRES_DB=journeymesh
# Change if something already owns 5432 on your machine.
POSTGRES_PORT=5432

# ---- Ports -----------------------------------------------------------------
WEB_PORT=5173
API_PORT=8000

# ---- Identity and access ---------------------------------------------------
# Optional here: a stable key is derived from the application name when this is
# blank, so tokens survive a reload with no configuration at all. In production
# it is required and must be at least 32 bytes (`openssl rand -hex 32`).
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
REGISTRATION_ENABLED=true

# Seeds an ADMIN at start-up when both are set; the password is never
# overwritten afterwards. ADMIN_URL is informational - where the admin signs in.
ADMIN_URL=http://localhost:5173/admin/login
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

# Optional ordinary USER account for demos, seeded after the admin; an existing
# account is never modified. USER_URL is informational.
USER_URL=http://localhost:5173/user/login
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_DISPLAY_NAME=Demo Traveller

# ---- Language model --------------------------------------------------------
# Blank means deterministic mode: the agents still route, plan and revise.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Uploaded media --------------------------------------------------------
# Local uploads land in ./storage/media, which is git-ignored.
MEDIA_STORAGE_DRIVER=local
MEDIA_ROOT=storage/media
MEDIA_BASE_URL=/media
MAX_UPLOAD_BYTES=10485760

# ---- Foreign exchange ------------------------------------------------------
# Works with no credentials. Note the ECB set has no BDT or AED - those pairs
# fall back to the indicative table and are labelled MOCK. Set FX_PROVIDER=erapi
# for keyless coverage that includes them, or FX_PROVIDER=offline to avoid all
# outbound calls.
FX_ENABLED=true
FX_PROVIDER=frankfurter
FX_CACHE_HOURS=6
DEFAULT_CURRENCY=USD

# ---- Live data providers ---------------------------------------------------
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
# The AviationStack MCP package reads this spelling. Set EITHER one -
# the application reads both and never needs the secret twice.
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=

# ---- MCP transports ------------------------------------------------------
# MCP is the preferred provider. "auto" is the default and means: use MCP when
# this deployment can actually reach a server, and fall back to the built-in
# adapter when it cannot. A missing key degrades quietly - it never breaks
# startup and never fabricates data.
#
#   auto             decide per server (below). The default.
#   stdio            run a local MCP server as a child process.
#   streamable_http  call a remote MCP server over HTTPS.
#   disabled         never use MCP for this provider.
#
# What "auto" resolves to:
#
#   weather    -> stdio, always. The server ships inside the image and is
#                 started as a subprocess. With OPENWEATHER_API_KEY it returns
#                 live observations; without one it returns clearly labelled
#                 ESTIMATE data.
#   search     -> streamable_http when TAVILY_API_KEY is set, otherwise the
#                 in-process adapter. The hosted Tavily endpoint URL is built
#                 by the application from that one key - do not paste the key
#                 into a URL here.
#   aviation   -> stdio when an AviationStack key is set AND the MCP server is
#                 installed (it is, in the Docker image), otherwise the
#                 in-process adapter.
#
# Check what actually happened:
#   curl 'http://localhost:8000/api/v1/health/mcp?probe=true'
MCP_SEARCH_TRANSPORT=auto
MCP_AVIATION_TRANSPORT=auto
MCP_WEATHER_TRANSPORT=auto

# ---- Observability ---------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=TravelCrewAI-Local
LANGSMITH_ENDPOINT=

# ---- Behaviour -------------------------------------------------------------
# True locally so a laptop with no provider keys still shows a full journey.
# False in production, where an unconfigured provider should say so.
ENABLE_MOCK_DATA=true
# --reload does not combine with multiple workers.
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
# Human-readable locally; production keeps json.
LOG_FORMAT=text

# Generous locally so a debugging session does not trip the limiter.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60

# On by default, here as in production. Turn one off only to reproduce a
# specific bug, and turn it back on.
GUARDRAILS_ENABLED=true
PROMPT_INJECTION_CHECK_ENABLED=true
PII_GUARD_ENABLED=true
TOOL_GUARD_ENABLED=true

EVALUATION_ENABLED=true
EVALUATION_MODE=deterministic
MAX_REVISION_COUNT=3
