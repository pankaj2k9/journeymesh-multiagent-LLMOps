# =============================================================================
# JourneyMesh - local development environment
#
#   cp .env.dev.example .env.dev
#   make dev-local
#
# This file configures docker-compose.dev.yml and nothing else. Production
# values live in /opt/journeymesh/.env ON THE VPS and never in this repository.
#
# Everything here is optional. With no credentials at all the stack runs end to
# end: the agents produce structured results and every unconfirmed price is
# labelled an ESTIMATE. Fill in only what you have.
#
# .env.dev is git-ignored. Only this template is committed, and it must never
# gain a real value - the repository is public.
# =============================================================================

APP_ENV=development
DEBUG=true

# ---- Database --------------------------------------------------------------
# Development-only credentials, deliberately trivial and deliberately public.
# The database is published on 127.0.0.1 only and holds nothing real.
POSTGRES_USER=journeymesh
POSTGRES_PASSWORD=journeymesh
POSTGRES_DB=journeymesh
# Change if something already owns 5432 on your machine.
POSTGRES_PORT=5432

# ---- Ports -----------------------------------------------------------------
WEB_PORT=5173
API_PORT=8000

# ---- Language model --------------------------------------------------------
# Blank means deterministic mode: the agents still route, plan and revise.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Live data providers ---------------------------------------------------
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=

# ---- MCP transports --------------------------------------------------------
# The application accepts exactly three values. Anything else is read as
# `disabled`:
#
#   disabled          the in-process adapter. No subprocess, no network.
#                     This is the default and is what you want most days.
#
#   stdio             run a local MCP server as a child process.
#                     Only `weather` ships one: the backend starts
#                     `python -m app.mcp.weather_server` and speaks MCP to it
#                     over its stdin and stdout. Setting `stdio` for search or
#                     aviation does nothing - they have no local server - and
#                     the client falls back to the in-process adapter.
#
#   streamable_http   a remote MCP server. Set the matching MCP_*_URL.
#                     `http` and `streamable-http` are accepted spellings.
#
# A server that cannot be reached degrades to the in-process adapter instead of
# failing the journey, so a typo shows up as deterministic data rather than an
# error. `curl localhost:8000/api/v1/health?verbose=true` reports what is
# actually in use.

MCP_SEARCH_TRANSPORT=disabled
MCP_SEARCH_URL=

MCP_WEATHER_TRANSPORT=disabled
MCP_WEATHER_URL=

MCP_AVIATION_TRANSPORT=disabled
MCP_AVIATION_URL=

# Local MCP, to exercise a real subprocess and a real MCP session:
#   MCP_WEATHER_TRANSPORT=stdio
#   OPENWEATHER_API_KEY=<your key>      # the child inherits this one
#
# Remote MCP, to exercise the network transport:
#   MCP_WEATHER_TRANSPORT=streamable_http
#   MCP_WEATHER_URL=http://host.docker.internal:9001/mcp

# ---- Observability ---------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=JourneyMesh-Local
LANGSMITH_ENDPOINT=

# ---- Behaviour -------------------------------------------------------------
# True locally so a laptop with no provider keys still shows a full journey.
# False in production, where an unconfigured provider should say so.
ENABLE_MOCK_DATA=true
# --reload does not combine with multiple workers.
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
# Human-readable locally; production keeps json.
LOG_FORMAT=text

# Generous locally so a debugging session does not trip the limiter.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60

# On by default, here as in production. Turn one off only to reproduce a
# specific bug, and turn it back on.
GUARDRAILS_ENABLED=true
PROMPT_INJECTION_CHECK_ENABLED=true
PII_GUARD_ENABLED=true
TOOL_GUARD_ENABLED=true

EVALUATION_ENABLED=true
EVALUATION_MODE=deterministic
MAX_REVISION_COUNT=3
