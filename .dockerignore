# ---- Secrets ----------------------------------------------------------------
# The build context is what the daemon receives; anything here can end up in a
# layer. These images are published to GHCR, so treat the context as public.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_ed25519
*_rsa
*_ed25519

# Database dumps and backups are production data.
backups/
*.sql
*.sql.gz
*.dump
*.dump.gz

# ---- VCS, CI and the production stack ---------------------------------------
# deploy/ is the VPS orchestration. It is never inside an image.
.git/
.github/
.gitignore
deploy/

# ---- Python -----------------------------------------------------------------
**/__pycache__/
**/*.py[cod]
backend/.venv/
backend/venv/
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/
backend/.coverage
backend/htmlcov/
backend/evals/reports/

# ---- Node -------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/vite.config.ts.timestamp-*

# ---- Local tooling ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
docs/
documents/
scripts/
Makefile
README.md
docker-compose*.yml
