# ---- Secrets -------------------------------------------------------------
# Every real environment file, including .env.local and .env.production.
.env
.env.*
!.env.example
!**/.env.example
# The production environment lives on the VPS; only its template is tracked.
deploy/.env
deploy/.env.images
!deploy/.env.prod.example
!deploy/.env.images.example
*.pem
*.key

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# ---- Node ----------------------------------------------------------------
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo
frontend/vite.config.ts.timestamp-*
npm-debug.log*
yarn-error.log*
.vite/

# ---- Editors / OS --------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# ---- Local database ------------------------------------------------------
# PostgreSQL's data files, bind-mounted from the local compose stack. The
# directory and its README are kept; its contents never are.
db/postgres-data/*
!db/postgres-data/.gitkeep

# ---- Deployment ----------------------------------------------------------
.vercel/

# ---- Local artefacts -----------------------------------------------------
backend/evals/reports/
*.sqlite3
