# =========================================================================
# JourneyMesh - Docker Compose environment
#
#   cp .env.example .env      then fill in whatever you actually have
#
# This file configures the *local compose stack* only. Running the backend
# directly (make dev) uses backend/.env, and the production deployment uses
# Render's environment variables. Nothing here is a secret by default.
#
# Everything is optional. With no credentials at all the stack still runs
# end to end and labels every unconfirmed price as an ESTIMATE.
# =========================================================================

# ---- Ports on your machine ----------------------------------------------
# Single-container stack (docker compose up): React and the API share a port.
APP_PORT=8000
# Split development stack (make docker-dev).
API_PORT=8000
WEB_PORT=5173
POSTGRES_PORT=5432

# ---- Local database ------------------------------------------------------
POSTGRES_USER=journeymesh
POSTGRES_PASSWORD=journeymesh
POSTGRES_DB=journeymesh

# The application only ever reads DATABASE_URL. Leave it empty to use the
# local `db` service; set it to a Neon connection string to run against the
# managed database instead. Change it together with the POSTGRES_* values.
DATABASE_URL=
# TLS is required for a managed provider and pointless inside the compose
# network, so the stack sets this to false for you.
DB_REQUIRE_SSL=

# ---- Application ---------------------------------------------------------
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
WEB_CONCURRENCY=2
ENABLE_MOCK_DATA=true

# ---- Provider credentials (all optional) --------------------------------
GROQ_API_KEY=
GROQ_MODEL=
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=

# ---- MCP transports: stdio | streamable_http | disabled -----------------
MCP_SEARCH_TRANSPORT=disabled
MCP_SEARCH_URL=
MCP_AVIATION_TRANSPORT=disabled
MCP_AVIATION_URL=
MCP_WEATHER_TRANSPORT=disabled
MCP_WEATHER_URL=

# ---- LangSmith observability (optional) ---------------------------------
# Tracing only starts when LANGSMITH_TRACING is true AND a key is present.
# JourneyMesh keeps planning journeys either way.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=JourneyMesh
LANGSMITH_ENDPOINT=

# ---- Guardrails and evaluation ------------------------------------------
GUARDRAILS_ENABLED=true
PROMPT_INJECTION_CHECK_ENABLED=true
PII_GUARD_ENABLED=true
TOOL_GUARD_ENABLED=true
EVALUATION_ENABLED=true
EVALUATION_MODE=deterministic
EVALUATOR_MODEL=

# ---- Human-in-the-loop ---------------------------------------------------
MAX_REVISION_COUNT=3

# ---- HTTP ----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_SIZE=65536
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# The single-container stack serves React from the same origin as the API,
# so this stays empty.
VITE_API_BASE_URL=
