# =============================================================================
# JourneyMesh - local Docker Compose environment
#
#   cp .env.example .env      then fill in whatever you actually have
#
# This file configures the LOCAL compose stack only. Production values live in
# /opt/journeymesh/.env on the OVHcloud VPS, never in this repository. Nothing
# here is a secret by default, and .env itself is git-ignored.
#
# Everything is optional. With no credentials at all the stack still runs end
# to end and labels every unconfirmed price as an ESTIMATE.
# =============================================================================

# ---- Ports on your machine ----------------------------------------------
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432

# ---- Local database ------------------------------------------------------
# These three create the database inside the postgres container. Change them
# together with DATABASE_URL below, or leave all four alone.
POSTGRES_DB=journeymesh
POSTGRES_USER=journeymesh
POSTGRES_PASSWORD=journeymesh

# The application only ever reads DATABASE_URL - there is no provider-specific
# code anywhere in it. `db` is the compose service name, resolved on the
# container network. Never use localhost here: inside a container that means
# the container itself, not your machine.
#
# Leave it empty to accept the default:
#   postgresql+psycopg://journeymesh:journeymesh@db:5432/journeymesh
#
# In production this same variable points at the PostgreSQL container on the
# VPS, assembled from POSTGRES_* in deploy/.env.prod.example. Nothing else
# changes.
DATABASE_URL=

# ---- Application ---------------------------------------------------------
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
WEB_CONCURRENCY=2

# Where the interface is served from, for CORS. The nginx container proxies
# /api to the backend, so the browser normally stays on one origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Compiled into the browser bundle at build time. Empty means "same origin",
# which is what the compose stack wants. Never put a secret in a VITE_ value.
VITE_API_BASE_URL=

# ---- Model ---------------------------------------------------------------
# Without a key the system runs in its deterministic mode: agents still
# produce structured results, and nothing is fabricated.
GROQ_API_KEY=
GROQ_MODEL=

# ---- Travel providers ----------------------------------------------------
# Each is independent. A missing key downgrades that section's provenance
# label from LIVE to ESTIMATE; it never fails a journey.
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=

# ---- MCP transports ------------------------------------------------------
# stdio, http, or disabled. "disabled" runs the tools through their
# in-process adapters, which is a supported state, not a fallback.
MCP_SEARCH_TRANSPORT=disabled
MCP_SEARCH_URL=
MCP_AVIATION_TRANSPORT=disabled
MCP_AVIATION_URL=
MCP_WEATHER_TRANSPORT=disabled
MCP_WEATHER_URL=

# ---- Observability -------------------------------------------------------
# Optional, and never load-bearing: a missing key or an unreachable endpoint
# cannot fail a journey.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=JourneyMesh
LANGSMITH_ENDPOINT=

# ---- Guardrails ----------------------------------------------------------
GUARDRAILS_ENABLED=true
PROMPT_INJECTION_CHECK_ENABLED=true
PII_GUARD_ENABLED=true
TOOL_GUARD_ENABLED=true

# ---- Evaluation ----------------------------------------------------------
EVALUATION_ENABLED=true
EVALUATION_MODE=deterministic
EVALUATOR_MODEL=

# ---- Limits --------------------------------------------------------------
MAX_REVISION_COUNT=3
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_SIZE=65536
ENABLE_MOCK_DATA=true
