# =============================================================================
# Travel Crew AI - local Docker Compose environment
#
#   cp .env.example .env      then fill in whatever you actually have
#
# This file configures the LOCAL compose stack only. Production values live in
# /opt/journeymesh/.env on the OVHcloud VPS, never in this repository. Nothing
# here is a secret by default, and .env itself is git-ignored.
#
# Everything is optional. With no credentials at all the stack still runs end
# to end and labels every unconfirmed price as an ESTIMATE.
# =============================================================================

# ---- Ports on your machine ----------------------------------------------
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432

# ---- Local database ------------------------------------------------------
# These three create the database inside the postgres container. Change them
# together with DATABASE_URL below, or leave all four alone.
POSTGRES_DB=journeymesh
POSTGRES_USER=journeymesh
POSTGRES_PASSWORD=journeymesh

# The application only ever reads DATABASE_URL - there is no provider-specific
# code anywhere in it. `db` is the compose service name, resolved on the
# container network. Never use localhost here: inside a container that means
# the container itself, not your machine.
#
# Leave it empty to accept the default:
#   postgresql+psycopg://journeymesh:journeymesh@db:5432/journeymesh
#
# In production this same variable points at the PostgreSQL container on the
# VPS, assembled from POSTGRES_* in deploy/.env.prod.example. Nothing else
# changes.
DATABASE_URL=

# ---- Application ---------------------------------------------------------
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
WEB_CONCURRENCY=2

# Where the interface is served from, for CORS. The nginx container proxies
# /api to the backend, so the browser normally stays on one origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Compiled into the browser bundle at build time. Empty means "same origin",
# which is what the compose stack wants. Never put a secret in a VITE_ value.
VITE_API_BASE_URL=

# ---- Identity and access -------------------------------------------------
# Signs the access and refresh tokens. REQUIRED in production - the service
# refuses to start issuing tokens without it, because a per-process fallback
# key would invalidate every session on restart and, behind two workers,
# accept a token from one process and reject it from the next.
#
#   openssl rand -hex 32
#
# Must be at least 32 bytes. Rotating it signs everyone out, which is the
# intended way to respond to a suspected leak.
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Close signups without redeploying, e.g. for a demo that should stay one
# account wide. The first account ever created becomes the ADMIN.
REGISTRATION_ENABLED=true

# ---- Model ---------------------------------------------------------------
# Without a key the system runs in its deterministic mode: agents still
# produce structured results, and nothing is fabricated.
GROQ_API_KEY=
GROQ_MODEL=

# ---- Foreign exchange ------------------------------------------------------
# Currency conversion works with no credentials at all. Frankfurter serves
# European Central Bank reference rates with no API key and no quota.
#
# IMPORTANT: the ECB set does NOT include BDT or AED. Those pairs fall back to
# the built-in indicative table and are labelled MOCK wherever they appear, per
# currency - every other pair stays LIVE. If taka or dirham pricing matters for
# your travellers, use the keyless alternative instead:
#
#   FX_PROVIDER=erapi
#
# which covers every currency this application supports.
#
#   frankfurter  ECB reference rates, ~30 currencies, no BDT/AED
#   erapi        open.er-api.com, broad coverage including BDT/AED
#   offline      the built-in indicative table; everything labelled MOCK
FX_ENABLED=true
FX_PROVIDER=frankfurter
FX_BASE_URL=https://api.frankfurter.app
FX_ERAPI_BASE_URL=https://open.er-api.com/v6/latest
FX_TIMEOUT_SECONDS=10
# The ECB publishes once a working day, so refetching more often than this
# spends a request to receive the same numbers.
FX_CACHE_HOURS=6

# Shown before a traveller has told us anything. The resolution order is
# account preference, then trip, then home country, then the browser's
# Accept-Language region, then this. IP geolocation is deliberately not used.
DEFAULT_CURRENCY=USD

# ---- Travel providers ----------------------------------------------------
# Each is independent. A missing key downgrades that section's provenance
# label from LIVE to ESTIMATE; it never fails a journey.
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
# The AviationStack MCP package reads this spelling. Set EITHER one -
# the application reads both and never needs the secret twice.
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=

# ---- MCP transports ------------------------------------------------------
# MCP is the preferred provider. "auto" is the default and means: use MCP when
# this deployment can actually reach a server, and fall back to the built-in
# adapter when it cannot. A missing key degrades quietly - it never breaks
# startup and never fabricates data.
#
#   auto             decide per server (below). The default.
#   stdio            run a local MCP server as a child process.
#   streamable_http  call a remote MCP server over HTTPS.
#   disabled         never use MCP for this provider.
#
# What "auto" resolves to:
#
#   weather    -> stdio, always. The server ships inside the image and is
#                 started as a subprocess. With OPENWEATHER_API_KEY it returns
#                 live observations; without one it returns clearly labelled
#                 ESTIMATE data.
#   search     -> streamable_http when TAVILY_API_KEY is set, otherwise the
#                 in-process adapter. The hosted Tavily endpoint URL is built
#                 by the application from that one key - do not paste the key
#                 into a URL here.
#   aviation   -> stdio when an AviationStack key is set AND the MCP server is
#                 installed (it is, in the Docker image), otherwise the
#                 in-process adapter.
#
# Check what actually happened:
#   curl 'http://localhost:8000/api/v1/health/mcp?probe=true'
MCP_SEARCH_TRANSPORT=auto
MCP_AVIATION_TRANSPORT=auto
MCP_WEATHER_TRANSPORT=auto

# ---- Observability -------------------------------------------------------
# Optional, and never load-bearing: a missing key or an unreachable endpoint
# cannot fail a journey.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=TravelCrewAI
LANGSMITH_ENDPOINT=

# ---- Guardrails ----------------------------------------------------------
GUARDRAILS_ENABLED=true
PROMPT_INJECTION_CHECK_ENABLED=true
PII_GUARD_ENABLED=true
TOOL_GUARD_ENABLED=true

# ---- Evaluation ----------------------------------------------------------
EVALUATION_ENABLED=true
EVALUATION_MODE=deterministic
# The judge's model, used only in hybrid or llm_judge mode. Blank means the
# judge uses GROQ_MODEL. Naming a different model here is what stops a model
# from marking its own homework, and a smaller one is usually the right choice.
EVALUATOR_MODEL=

# ---- Limits --------------------------------------------------------------
MAX_REVISION_COUNT=3
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_SIZE=65536
ENABLE_MOCK_DATA=true
