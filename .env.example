# =========================================================================
# JourneyMesh - Docker Compose environment
#
#   cp .env.example .env      then fill in whatever you actually have
#
# This file configures the *compose stack* only. Running the backend
# directly (make dev) uses backend/.env instead.
#
# Everything here is optional. With no credentials at all the stack still
# runs end to end and labels every unconfirmed price as an ESTIMATE.
# =========================================================================

# ---- Ports on your machine ----------------------------------------------
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432

# ---- Database (the API's DATABASE_URL is assembled from these) ----------
POSTGRES_USER=journeymesh
POSTGRES_PASSWORD=journeymesh
POSTGRES_DB=journeymesh

# ---- Application ---------------------------------------------------------
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
WEB_CONCURRENCY=2

# ---- Provider credentials (all optional) --------------------------------
GROQ_API_KEY=
GROQ_MODEL=
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=

# ---- MCP transports: stdio | streamable_http | disabled -----------------
MCP_SEARCH_TRANSPORT=disabled
MCP_SEARCH_URL=
MCP_AVIATION_TRANSPORT=disabled
MCP_AVIATION_URL=
MCP_WEATHER_TRANSPORT=disabled
MCP_WEATHER_URL=

# ---- Guardrails and evaluation ------------------------------------------
GUARDRAILS_ENABLED=true
PROMPT_INJECTION_CHECK_ENABLED=true
PII_GUARD_ENABLED=true
TOOL_GUARD_ENABLED=true
EVALUATION_ENABLED=true
EVALUATION_MODE=deterministic
EVALUATOR_MODEL=

# ---- Human-in-the-loop ---------------------------------------------------
MAX_REVISION_COUNT=3

# ---- HTTP ----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_SIZE=65536
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The interface is served from the same origin as the API by nginx, so this
# stays empty for the compose stack.
VITE_API_BASE_URL=
