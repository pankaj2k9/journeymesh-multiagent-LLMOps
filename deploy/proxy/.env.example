# =============================================================================
# Shared reverse proxy environment - /opt/proxy/.env on the VPS
#
#   scp deploy/proxy/.env.example deploy@<vps-ip>:/opt/proxy/.env
#
# Nothing here is a secret. It holds no domain and no application setting:
# every application's domains live in its own file under /opt/proxy/sites/.
# =============================================================================

# The ACME account e-mail shared by every certificate on this VPS. Let's
# Encrypt uses it for expiry and policy notices. If this line is removed,
# docker-compose.yml falls back to admin@travelcrewai.com.
ACME_EMAIL=admin@travelcrewai.com
