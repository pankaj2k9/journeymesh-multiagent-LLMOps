# =============================================================================
# Shared reverse proxy environment - /opt/proxy/.env on the VPS
#
#   scp deploy/proxy/.env.example deploy@<vps-ip>:/opt/proxy/.env
#
# Nothing here is a secret, but the file is not committed with real values
# because the domains are deployment facts, not repository facts.
# =============================================================================

# Let's Encrypt expiry warnings go here.
ACME_EMAIL=you@example.com

# The domain whose A record points at this VPS. Caddy requests a certificate
# for exactly this name, so it must resolve before the proxy first starts.
JOURNEYMESH_DOMAIN=journeymesh.example.com

# Uncomment as each application is added, alongside its block in the Caddyfile.
# SAAS2_DOMAIN=saas2.example.com
# SAAS3_DOMAIN=saas3.example.com
