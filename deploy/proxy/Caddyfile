# =============================================================================
# Shared reverse proxy - /opt/proxy/Caddyfile on the VPS
#
# This file belongs to the SERVER, not to any application. It holds only what
# every site on the machine shares:
#
#   1. global options (the ACME account e-mail)
#   2. reusable snippets that site files `import`
#   3. one `import` line that pulls in every site under /etc/caddy/sites/
#
# Each SaaS application owns exactly one file in sites/, named after it:
#
#   /opt/proxy/
#   ├── docker-compose.yml
#   ├── Caddyfile                  <- this file, rarely edited
#   ├── .env                       <- ACME_EMAIL only
#   ├── reload.sh                  <- validate, then reload gracefully
#   └── sites/
#       ├── travelcrewai.caddy     <- Travel Crew AI
#       └── <next-saas>.caddy      <- copied from _template.caddy.example
#
# Adding, changing or removing an application is a change to its own file in
# sites/ followed by ./reload.sh. This file, and every other site, stays as it
# is. Only files ending in `.caddy` are loaded, so `*.caddy.example`,
# `*.caddy.disabled` and backups are ignored.
#
# Snippets must be defined ABOVE the import line: Caddy expands `import`
# in place, so a site can only use a snippet that already exists.
# =============================================================================
{
	# The ACME account e-mail, used by Let's Encrypt / ZeroSSL for expiry and
	# policy notices. It is shared by every certificate on this VPS, so it is an
	# operator address rather than an application's. Set ACME_EMAIL in
	# /opt/proxy/.env; the default applies when it is absent.
	email {$ACME_EMAIL:admin@travelcrewai.com}
}

# -----------------------------------------------------------------------------
# (common) - compression, baseline security headers, structured access logs.
# Every site imports it.
# -----------------------------------------------------------------------------
(common) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# -----------------------------------------------------------------------------
# (hsts) - opt-in, per site, once HTTPS for that name is confirmed working.
#
# One year, and deliberately WITHOUT includeSubDomains or preload: those would
# pin every subdomain - including ones another application may later serve
# differently - to HTTPS in every browser that saw the header, for a year.
# -----------------------------------------------------------------------------
(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

# -----------------------------------------------------------------------------
# (www_redirect) - send www.<domain> to the bare domain, permanently.
#
#   www.example.com {
#   	import www_redirect example.com
#   }
# -----------------------------------------------------------------------------
(www_redirect) {
	import common
	redir https://{args[0]}{uri} permanent
}

# -----------------------------------------------------------------------------
# Every application's routes. One file per SaaS.
# -----------------------------------------------------------------------------
import /etc/caddy/sites/*.caddy
