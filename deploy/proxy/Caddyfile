# =============================================================================
# Shared reverse proxy - routing for every application on this VPS
#
# One site address per application, all of them fed from /opt/proxy/.env, so
# adding a SaaS is one variable here and one variable there.
#
# TWO MODES, one file. The mode is decided entirely by the VALUE of
# JOURNEYMESH_DOMAIN in /opt/proxy/.env - nothing in this file changes:
#
#   IP mode, today          JOURNEYMESH_DOMAIN=http://51.79.166.97
#     The explicit http:// scheme tells Caddy to serve plain HTTP and to skip
#     certificate management entirely. Let's Encrypt will not issue for a bare
#     IP address, so asking would fail rather than degrade.
#
#   Domain mode, later      JOURNEYMESH_DOMAIN=journeymesh.example.com
#     No scheme means Caddy's default: automatic HTTPS, an automatic redirect
#     from port 80, and renewal about 30 days before expiry. Point the A
#     record at this VPS first, then change the variable and reload.
#
# Moving between the modes is a change to /opt/proxy/.env and one reload. See
# the HSTS note in the (common) snippet before you switch.
# =============================================================================

{
	# No `email` directive here on purpose. It requires a non-empty argument,
	# so an unset ACME_EMAIL would be a syntax error rather than a harmless
	# no-op, and in IP mode there is no ACME account for it to belong to.
	# Caddy does not need one to issue certificates in domain mode either.
	#
	# When you move to a domain and want Let's Encrypt expiry warnings, set
	# ACME_EMAIL in /opt/proxy/.env and uncomment the next line.
	#
	# email {$ACME_EMAIL}
}

# -----------------------------------------------------------------------------
# Common configuration shared by all sites
# -----------------------------------------------------------------------------

(common) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server

		# Strict-Transport-Security is deliberately absent while this VPS
		# serves plain HTTP. Sending it over http:// is at best ignored, and
		# on a name it would pin that name to HTTPS in every browser that saw
		# it - for two years, before a certificate exists. Uncomment it in
		# domain mode, once HTTPS actually works:
		#
		# Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}

	log {
		output stdout
		format json
	}
}

# =============================================================================
# JourneyMesh
# =============================================================================
#
# The frontend container joins the shared `proxy` network under the alias
# `journeymesh-frontend` (see deploy/docker-compose.prod.yml). It publishes no
# host port: Caddy is the only thing that can reach it, over that network.
#
# X-Forwarded-Proto carries the real scheme through to nginx and FastAPI, so
# the application knows whether the browser is on http or https without this
# file having to tell it twice.
# =============================================================================

{$JOURNEYMESH_DOMAIN} {
	import common

	reverse_proxy journeymesh-frontend:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
	}
}

# =============================================================================
# SaaS 2
# =============================================================================
#
# Add SAAS2_DOMAIN to /opt/proxy/.env, uncomment this block, and reload. The
# same two modes apply: an http:// prefix serves plain HTTP, a bare name gets
# automatic HTTPS.
#
# {$SAAS2_DOMAIN} {
# 	import common
#
# 	reverse_proxy saas2-frontend:80 {
# 		header_up X-Forwarded-Proto {scheme}
# 		header_up X-Forwarded-For {remote_host}
# 		header_up Host {host}
# 	}
# }
#
# The SaaS 2 frontend needs the network alias `saas2-frontend` on `proxy`.
# =============================================================================

