# Written by the deploy workflow on every release; committed here only so the
# first manual `docker compose` on a fresh VPS has something to read.
#
# Both tags are immutable digest-free image references pinned to a commit SHA,
# so `docker compose up -d` on the VPS can never quietly pick up a different
# build than the one the workflow verified.
BACKEND_IMAGE=ghcr.io/<owner>/journeymesh-backend:latest
FRONTEND_IMAGE=ghcr.io/<owner>/journeymesh-frontend:latest
