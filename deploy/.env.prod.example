# =============================================================================
# JourneyMesh - production environment for the OVHcloud VPS
#
# Copy this to /opt/journeymesh/.env ON THE VPS and fill it in there. It is the
# only place production secrets live: not in the repository, not in the image,
# not in the GitHub Actions workflow.
#
#   scp deploy/.env.prod.example deploy@<vps-ip>:/opt/journeymesh/.env
#   ssh deploy@<vps-ip> 'chmod 600 /opt/journeymesh/.env && nano /opt/journeymesh/.env'
#
# The deploy workflow never writes this file. It rewrites only the two image
# tags in /opt/journeymesh/.env.images, so editing this by hand is safe.
#
# The domain and the ACME address are NOT here: TLS belongs to the shared
# reverse proxy, and its settings live in /opt/proxy/.env.
# =============================================================================

# ---- Images --------------------------------------------------------------
# Normally supplied by /opt/journeymesh/.env.images, which the deploy workflow
# rewrites on every release with the exact commit SHA it built. Set them here
# only if you deploy by hand without that file.
# BACKEND_IMAGE=ghcr.io/<owner>/journeymesh-backend:<git-sha>
# FRONTEND_IMAGE=ghcr.io/<owner>/journeymesh-frontend:<git-sha>

# ---- Database ------------------------------------------------------------
# Generate the password once, on the VPS, and never reuse it:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
#
# PostgreSQL publishes no host port. Reach it through the container:
#   docker compose -f docker-compose.prod.yml exec db psql -U journeymesh -d journeymesh
POSTGRES_USER=journeymesh
POSTGRES_PASSWORD=
POSTGRES_DB=journeymesh
# The database is on this host, on a private container network, so TLS adds
# nothing. Set it to true if you move to a managed PostgreSQL.
DB_REQUIRE_SSL=false

# ---- Language model ------------------------------------------------------
# Blank means deterministic mode: the agents still produce structured results,
# and every unconfirmed price is labelled an ESTIMATE.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Live data providers -------------------------------------------------
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=

# ---- MCP transports ------------------------------------------------------
MCP_SEARCH_TRANSPORT=disabled
MCP_SEARCH_URL=
MCP_AVIATION_TRANSPORT=disabled
MCP_AVIATION_URL=
MCP_WEATHER_TRANSPORT=disabled
MCP_WEATHER_URL=

# ---- Observability -------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=JourneyMesh
LANGSMITH_ENDPOINT=

# ---- Serving -------------------------------------------------------------
# The browser calls /api on the same origin, so cross-origin requests are not
# part of normal operation. Leave this empty unless another site calls the API.
CORS_ORIGINS=
# One uvicorn worker. This VPS is 2 vCPU / 4 GB and will eventually run three
# SaaS stacks, so the default is deliberately conservative. Raise it here once
# real memory use is known; 2 is the most this machine should ever give one app.
WEB_CONCURRENCY=1

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_SIZE=65536

# ---- Guardrails ----------------------------------------------------------
GUARDRAILS_ENABLED=true
PROMPT_INJECTION_CHECK_ENABLED=true
PII_GUARD_ENABLED=true
TOOL_GUARD_ENABLED=true

# ---- Evaluation ----------------------------------------------------------
EVALUATION_ENABLED=true
EVALUATION_MODE=deterministic
EVALUATOR_MODEL=

# ---- Behaviour -----------------------------------------------------------
MAX_REVISION_COUNT=3
# False in production. Mock data is a local convenience; a deployed system
# should say it has no provider rather than invent one.
ENABLE_MOCK_DATA=false
LOG_LEVEL=INFO
