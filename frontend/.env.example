# =============================================================================
# JourneyMesh - frontend environment
#
#   cp frontend/.env.example frontend/.env
#
# Only VITE_* variables reach the browser, and Vite compiles them into the
# bundle at BUILD time. Never put a secret here: anyone can read it.
# =============================================================================

# Base URL of the JourneyMesh API.
#
# Empty is correct for every local setup, because something already proxies
# /api to the backend for you:
#
#   make dev              the Vite dev server proxies /api -> 127.0.0.1:8000
#   docker compose up     nginx proxies /api -> backend:8000
#
# Leaving it empty means the browser stays on one origin, so there is no
# cross-origin request and no CORS to configure.
#
# Set it only for a split deployment where the browser calls the API on
# another origin - for example the Railway frontend service:
#
#   VITE_API_BASE_URL=https://<your-backend>.up.railway.app
#
# If you set it, three things must agree, or every request fails:
#   1. this value                      the URL the browser calls
#   2. the backend's CORS_ORIGINS      the origin the API accepts
#   3. JOURNEYMESH_CONNECT_SRC         the CSP the page is served with
VITE_API_BASE_URL=
