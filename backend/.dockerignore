# ---- Secrets ----------------------------------------------------------------
# The build context is what the daemon receives; anything here can end up in a
# layer. These images are published to GHCR, so treat the context as public.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_ed25519
*_rsa
*_ed25519

# Database dumps and backups are production data.
backups/
*.sql
*.sql.gz
*.dump
*.dump.gz

# Local environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
evals/reports/

# Not needed inside the image
Dockerfile
.dockerignore

# The test suite is kept, so `docker compose run --rm api pytest -q` works.
