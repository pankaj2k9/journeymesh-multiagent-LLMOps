# =========================================================================
# JourneyMesh - backend environment template
# Every journey, intelligently connected.
#
# Copy to backend/.env and fill in the values you actually have.
# Never commit a filled-in .env file.
# =========================================================================

# ---- Application ---------------------------------------------------------
APP_NAME=JourneyMesh
APP_ENV=development
DEBUG=true

# ---- Database ------------------------------------------------------------
# Example shape (do not commit real credentials):
# postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# ---- Language model ------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=

# ---- Providers -----------------------------------------------------------
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=

# ---- MCP transports ------------------------------------------------------
# Transport values: stdio | streamable_http | disabled
MCP_SEARCH_TRANSPORT=
MCP_SEARCH_URL=
MCP_AVIATION_TRANSPORT=
MCP_AVIATION_URL=
MCP_WEATHER_TRANSPORT=
MCP_WEATHER_URL=

# ---- HTTP security -------------------------------------------------------
CORS_ORIGINS=
RATE_LIMIT_ENABLED=
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
MAX_REQUEST_SIZE=

# ---- Guardrails ----------------------------------------------------------
GUARDRAILS_ENABLED=
PROMPT_INJECTION_CHECK_ENABLED=
PII_GUARD_ENABLED=
TOOL_GUARD_ENABLED=

# ---- Observability: LangSmith -------------------------------------------
# Tracing starts only when LANGSMITH_TRACING is true and a key is present.
# JourneyMesh keeps working when LangSmith is missing, disabled or unreachable.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=

# ---- Evaluation ----------------------------------------------------------
EVALUATION_ENABLED=
# EVALUATION_MODE: deterministic | hybrid | llm_judge
EVALUATION_MODE=
EVALUATOR_MODEL=

# ---- Human-in-the-loop ---------------------------------------------------
MAX_REVISION_COUNT=

# ---- Serving -------------------------------------------------------------
# The platform supplies PORT in production; 8000 is the local fallback.
PORT=
# When true and a React build is present, FastAPI also serves the interface.
SERVE_FRONTEND=
FRONTEND_DIST_DIR=

# ---- Database connection management --------------------------------------
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT_SECONDS=
DB_POOL_RECYCLE_SECONDS=
DB_CONNECT_TIMEOUT_SECONDS=
DB_STATEMENT_TIMEOUT_MS=
# TLS is added automatically for a remote host; set false only for local use.
DB_REQUIRE_SSL=
RUN_MIGRATIONS_ON_STARTUP=

# ---- URLs ----------------------------------------------------------------
FRONTEND_URL=
BACKEND_URL=

# ---- Local development ---------------------------------------------------
# When true, providers that have no API key fall back to clearly labelled
# deterministic sample data instead of failing the request.
ENABLE_MOCK_DATA=
