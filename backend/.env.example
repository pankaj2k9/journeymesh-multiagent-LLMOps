# =============================================================================
# JourneyMesh - backend environment
#
#   cp backend/.env.example backend/.env
#
# This file is used when you run the backend DIRECTLY on your machine:
#
#   make dev          FastAPI on :8000 and Vite on :5173
#   make backend-run  FastAPI alone
#
# It is NOT used by the containers. `docker compose up` passes environment
# from the root .env and docker-compose.yml, and production values live in
# /opt/journeymesh/.env on the VPS. Same variable names everywhere - only the
# values differ.
#
# Everything below is filled in with a working local default except the API
# keys, which are yours to add. With every key blank the system still runs end
# to end and labels every unconfirmed price as an ESTIMATE.
#
# Never commit a filled-in .env.
# =============================================================================

# ---- Application ---------------------------------------------------------
APP_NAME=JourneyMesh
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---- Database ------------------------------------------------------------
# Running on your machine, so the database is localhost: the compose `db`
# container publishes 5432 on the host. Start it with:
#
#   docker compose up -d db
#
# Inside a container this would be wrong - there the host is `db`, not
# localhost. See docker-compose.yml.
DATABASE_URL=postgresql+psycopg://journeymesh:journeymesh@localhost:5432/journeymesh

# Leave DATABASE_URL empty instead and the API falls back to an ephemeral
# in-memory database - fine for a quick look, but journeys do not survive a
# restart, and /api/v1/health reports it honestly.

# In production docker-compose.prod.yml assembles this same variable from the
# POSTGRES_* values in /opt/journeymesh/.env on the VPS - never here.
# See deploy/OVHCLOUD.md.

# ---- Language model ------------------------------------------------------
# Blank means deterministic mode: agents still produce structured results.
GROQ_API_KEY=
GROQ_MODEL=

# ---- Travel providers ----------------------------------------------------
# Each is independent. A missing key downgrades that section's provenance
# label from LIVE to ESTIMATE; it never fails a journey.
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
# The AviationStack MCP package reads this spelling. Set EITHER one -
# the application reads both and never needs the secret twice.
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=

# ---- MCP transports ------------------------------------------------------
# MCP is the preferred provider. "auto" is the default and means: use MCP when
# this deployment can actually reach a server, and fall back to the built-in
# adapter when it cannot. A missing key degrades quietly - it never breaks
# startup and never fabricates data.
#
#   auto             decide per server (below). The default.
#   stdio            run a local MCP server as a child process.
#   streamable_http  call a remote MCP server over HTTPS.
#   disabled         never use MCP for this provider.
#
# What "auto" resolves to:
#
#   weather    -> stdio, always. The server ships inside the image and is
#                 started as a subprocess. With OPENWEATHER_API_KEY it returns
#                 live observations; without one it returns clearly labelled
#                 ESTIMATE data.
#   search     -> streamable_http when TAVILY_API_KEY is set, otherwise the
#                 in-process adapter. The hosted Tavily endpoint URL is built
#                 by the application from that one key - do not paste the key
#                 into a URL here.
#   aviation   -> stdio when an AviationStack key is set AND the MCP server is
#                 installed (it is, in the Docker image), otherwise the
#                 in-process adapter.
#
# Check what actually happened:
#   curl 'http://localhost:8000/api/v1/health/mcp?probe=true'
MCP_SEARCH_TRANSPORT=auto
MCP_AVIATION_TRANSPORT=auto
MCP_WEATHER_TRANSPORT=auto

# Only for a self-hosted MCP server. Leave empty for the defaults above.
# Never put a credential in these: they are echoed back, redacted, by the
# health endpoint, and a URL is easier to leak than a variable.
MCP_SEARCH_URL=
MCP_AVIATION_URL=
MCP_WEATHER_URL=

# ---- HTTP security -------------------------------------------------------
# The Vite dev server on 5173 is a different origin from the API on 8000, so
# CORS is real in local development. In production this is the frontend's
# public URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_SIZE=65536

# ---- Guardrails ----------------------------------------------------------
GUARDRAILS_ENABLED=true
PROMPT_INJECTION_CHECK_ENABLED=true
PII_GUARD_ENABLED=true
TOOL_GUARD_ENABLED=true

# ---- Observability: LangSmith -------------------------------------------
# Tracing starts only when LANGSMITH_TRACING is true AND a key is present.
# JourneyMesh keeps working when LangSmith is missing, disabled or unreachable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=JourneyMesh
LANGSMITH_ENDPOINT=

# ---- Evaluation ----------------------------------------------------------
EVALUATION_ENABLED=true
# deterministic | hybrid | llm_judge
EVALUATION_MODE=deterministic
EVALUATOR_MODEL=

# ---- Human-in-the-loop ---------------------------------------------------
MAX_REVISION_COUNT=3

# ---- Serving -------------------------------------------------------------
# The production Compose file supplies PORT; 8000 is the local value. The
# server always binds 0.0.0.0.
PORT=8000
# False locally: Vite serves the interface. The single-container image sets
# this to true so FastAPI serves the React build as well.
SERVE_FRONTEND=false
FRONTEND_DIST_DIR=

# ---- Database connection management --------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=900
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
# TLS is added automatically for a remote host and skipped for a local one.
# False here; true in production.
DB_REQUIRE_SSL=false
# The compose `migrate` service owns migrations, locally and in production,
# so the server does not run them itself.
RUN_MIGRATIONS_ON_STARTUP=false

# ---- URLs ----------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---- Local development ---------------------------------------------------
# Providers with no API key fall back to clearly labelled deterministic
# sample data instead of failing the request.
ENABLE_MOCK_DATA=true
