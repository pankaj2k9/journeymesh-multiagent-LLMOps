   "autoResize": true,
   "lineHeight": 1.25,
   "text": "TripMate AI \u2014 a multi-agent travel planner",
   "originalText": "TripMate AI \u2014 a multi-agent travel planner",
   "index": "a00000"
  },
  {
   "id": "sjht0lLOxJednRBuLDtYS",
   "type": "text",
   "x": 60.0,
   "y": 110.0,
   "width": 946.96,
   "height": 142.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1048386556,
   "version": 1,
   "versionNonce": 351564608,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "text": "Takes a plain-English trip request and returns something you could actually book against:\nflight options, hotel candidates and a day-by-day itinerary. The work is split across\nspecialist agents coordinated by LangGraph, with shared state passed between them.\n\nPlanning a trip by hand means bouncing between a dozen tabs and reconciling the results\nyourself. One agent per concern keeps each prompt small and each failure easy to locate.",
   "originalText": "Takes a plain-English trip request and returns something you could actually book against:\nflight options, hotel candidates and a day-by-day itinerary. The work is split across\nspecialist agents coordinated by LangGraph, with shared state passed between them.\n\nPlanning a trip by hand means bouncing between a dozen tabs and reconciling the results\nyourself. One agent per concern keeps each prompt small and each failure easy to locate.",
   "index": "a00001"
  },
